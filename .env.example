# Explicit local mode uses SQLite and does not require an access key.
APP_NAME=DocFlow-AI
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DEPLOYMENT_MODE=local
DATABASE_URL=sqlite+aiosqlite:///./app.db
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
LOG_LEVEL=INFO
REQUEST_ID_HEADER=X-Request-ID
STORAGE_DIR=storage/uploads
MAX_UPLOAD_SIZE_MB=10
MAX_EXTRACTED_TEXT_CHARS=500000
MAX_TEXT_BYTES=2000000
MAX_PDF_PAGES=100
MAX_OFFICE_UNCOMPRESSED_BYTES=50000000
MAX_OFFICE_COMPRESSION_RATIO=100
MAX_WORKSHEETS=25
MAX_ROWS=20000
MAX_CELLS=200000
ALLOWED_EXTENSIONS=.txt,.md,.csv,.json,.pdf,.docx,.xlsx
